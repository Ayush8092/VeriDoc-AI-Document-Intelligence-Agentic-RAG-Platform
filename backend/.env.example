# Copy this file to .env and fill in real values. Nothing here is a secret.

# ==========================================================
# API KEYS (all optional at startup — required only when
# their provider is actually called; see app/clients.py)
# ==========================================================
GEMINI_API_KEY=
GROQ_API_KEY=
PINECONE_API_KEY=

# ==========================================================
# DATABASE
# ==========================================================
# Local dev / tests: leave unset to use ./data/veridoc.db (SQLite).
# Production: point at PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg2://veridoc:password@localhost:5432/veridoc
DATABASE_URL=

# ==========================================================
# PINECONE
# ==========================================================
PINECONE_INDEX_NAME=veridoc-documents
PINECONE_NAMESPACE=veridoc-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ==========================================================
# EMBEDDINGS / ANSWER MODEL
# ==========================================================
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
ANSWER_MODEL=openai/gpt-oss-20b
ANSWER_TEMPERATURE=0.0

# ==========================================================
# RETRIEVAL / RERANKING / RAG WORKFLOW
# ==========================================================
TOP_K=10
SCORE_THRESHOLD=0.45
QUERY_FANOUT=3
RERANK_ENABLED=true
RERANK_TOP_K=8
MAX_RETRIEVAL_LOOPS=2

# --- Phase 3A: cross-encoder reranking ---
# Falls back to the BM25 lexical reranker automatically (per-process,
# logged once) if the model/package can't be loaded — see
# app/rag/cross_encoder.py. Safe to leave true even without the optional
# sentence-transformers dependency installed.
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Phase 3A: hybrid retrieval (dense + BM25 fusion) ---
# Requires data/lexical_index.json to exist, i.e. ingestion must have run
# at least once after upgrading to Phase 3A — see app/lexical_index.py.
HYBRID_RETRIEVAL_ENABLED=true
BM25_TOP_K=10
RRF_K=60
LEXICAL_INDEX_PATH=data/lexical_index.json
LEXICAL_INDEX_CACHE_ENABLED=true

# --- Phase 3A: query classification ---
# Off by default: the deterministic rules (app/rag/query_classifier.py)
# already cover routing-relevant distinctions without adding an LLM call
# to every request.
QUERY_CLASSIFIER_LLM_ENABLED=false

# --- Phase 3A: claim-level grounding ---
# Adds LLM calls after generation to verify each claim in the answer
# against its cited evidence — see app/rag/grounding.py.
CLAIM_GROUNDING_ENABLED=true
CLAIM_GROUNDING_MAX_CLAIMS=8

# ==========================================================
# OCR / DOCUMENT PROCESSING
# (requires system packages: tesseract-ocr, poppler-utils —
# see docs/ocr.md "System dependencies")
# ==========================================================
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MIN_NATIVE_CHARS_PER_PAGE=20
OCR_CONFIDENCE_FLOOR=0.0

# ==========================================================
# INGESTION
# ==========================================================
CORPUS_DIR=data/corpus
UPLOAD_DIR=data/uploads
MAX_UPLOAD_FILE_SIZE_BYTES=26214400

# ==========================================================
# API SERVER
# ==========================================================
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
INCLUDE_TRACE=false
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
SERVICE_INIT_TIMEOUT_SECONDS=30
